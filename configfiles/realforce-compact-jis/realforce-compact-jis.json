{
    "title": "RealForce Compact (JIS) for JIS Korean",
    "rules": [
        {
            "description": "RealForce Compact (JIS) for JIS Korean: Control left of A; bottom row カタカナ, ⌥, ⌘, 英数, Space, かな, ⌘, ⌥, Caps Lock, Control; ろ is \\ (_ shifted)",
            "manipulators": [
                {
                    "type": "basic",
                    "description": "Caps Lock (left of A): Left Control",
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_control"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "vendor_id": 2131,
                                    "product_id": 512,
                                    "is_keyboard": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "description": "Left Control: カタカナ (to Korean)",
